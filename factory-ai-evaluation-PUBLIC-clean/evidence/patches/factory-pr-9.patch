From b773cc378e293a58f01ee3e70ad9fd80235a8496 Mon Sep 17 00:00:00 2001
From: anushreegoyal <redacted@invalid.example>
Date: Mon, 9 Nov 2026 01:04:07 +0100
Subject: [PATCH] Fix: slugify handles accents and whitespace (fixes #3)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- Normalize Unicode to NFD and strip combining diacritical marks
- Replace all whitespace (tabs, newlines, multiple spaces) with single hyphen
- Add regression tests for accents (Café Résumé, München, São Paulo)
- Add regression tests for whitespace (tabs, newlines, multiple spaces, leading/trailing)
---
 src/utils.js       |  4 +++-
 test/utils.test.js | 13 +++++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/utils.js b/src/utils.js
index 25631f6..cb92d81 100644
--- a/src/utils.js
+++ b/src/utils.js
@@ -3,7 +3,9 @@ export function slugify(title) {
   return title
     .toLowerCase()
     .trim()
-    .replace(/ /g, '-')
+    .normalize('NFD')
+    .replace(/[\u0300-\u036f]/g, '')
+    .replace(/\s+/g, '-')
     .replace(/[^a-z0-9-]/g, '');
 }

diff --git a/test/utils.test.js b/test/utils.test.js
index 4f642ed..3623425 100644
--- a/test/utils.test.js
+++ b/test/utils.test.js
@@ -10,6 +10,19 @@ test('slugify strips punctuation', () => {
   assert.equal(slugify('Ship it!'), 'ship-it');
 });

+test('slugify handles accents', () => {
+  assert.equal(slugify('Café Résumé'), 'cafe-resume');
+  assert.equal(slugify('München'), 'munchen');
+  assert.equal(slugify('São Paulo'), 'sao-paulo');
+});
+
+test('slugify handles all whitespace', () => {
+  assert.equal(slugify('Hello\tWorld'), 'hello-world');
+  assert.equal(slugify('Hello\nWorld'), 'hello-world');
+  assert.equal(slugify('Hello  World'), 'hello-world');
+  assert.equal(slugify('  Hello World  '), 'hello-world');
+});
+
 test('paginate reports totals', () => {
   const items = Array.from({ length: 25 }, (_, i) => i);
   const result = paginate(items, 1, 10);
