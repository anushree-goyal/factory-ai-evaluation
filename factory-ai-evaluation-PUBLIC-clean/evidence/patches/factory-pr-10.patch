       if (req.method === 'GET' && id === undefined) {
         const page = Number(url.searchParams.get('page') ?? 1);
         const size = Number(url.searchParams.get('size') ?? 10);
-        return send(res, 200, paginate(store.list(), page, size));
+        const doneParam = url.searchParams.get('done');
+        let todos = store.list();
+        if (doneParam !== null) {
+          if (doneParam !== 'true' && doneParam !== 'false') {
+            return send(res, 400, { error: 'done must be true or false' });
+          }
+          const done = doneParam === 'true';
+          todos = todos.filter((t) => t.done === done);
+        }
+        return send(res, 200, paginate(todos, page, size));
       }
       if (req.method === 'GET') {
