diff --git a/test/server.test.js b/test/server.test.js
index c4b8953..d071ed5 100644
--- a/test/server.test.js
+++ b/test/server.test.js
@@ -26,3 +26,48 @@ test('unknown route returns 404', async () => {
   const res = await fetch(`${base}/nope`);
   assert.equal(res.status, 404);
 });
+
+// Filter tests use a fresh server to avoid interference from other tests
+let filterServer;
+let filterBase;
+
+before(async () => {
+  filterServer = createServer();
+  await new Promise((r) => filterServer.listen(0, r));
+  filterBase = `http://localhost:${filterServer.address().port}`;
+});
+
+after(() => filterServer.close());
+
+test('GET /todos supports done=true filter', async () => {
+  // Create a completed and an incomplete todo
+  const done = await fetch(`${filterBase}/todos`, {
+    method: 'POST',
+    body: JSON.stringify({ title: 'Done task' }),
+  }).then((r) => r.json());
+  await fetch(`${filterBase}/todos/${done.id}`, { method: 'PATCH' });
+  await fetch(`${filterBase}/todos`, {
+    method: 'POST',
+    body: JSON.stringify({ title: 'Pending task' }),
+  }).then((r) => r.json());
+
+  const filtered = await fetch(`${filterBase}/todos?done=true`).then((r) => r.json());
+  assert.equal(filtered.total, 1);
+  assert.equal(filtered.items.length, 1);
+  assert.equal(filtered.items[0].id, done.id);
+  assert.equal(filtered.items[0].done, true);
+});
+
+test('GET /todos supports done=false filter', async () => {
+  const filtered = await fetch(`${filterBase}/todos?done=false`).then((r) => r.json());
+  assert.equal(filtered.total, 1);
+  assert.equal(filtered.items.length, 1);
+  assert.equal(filtered.items[0].done, false);
+});
+
+test('GET /todos rejects invalid done value', async () => {
+  const res = await fetch(`${filterBase}/todos?done=yes`);
+  assert.equal(res.status, 400);
+  const body = await res.json();
+  assert.equal(body.error, 'done must be true or false');
+});
